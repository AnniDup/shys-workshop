---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import Figure from '../../../components/Figure.astro';
import SheetNav from '../../../components/SheetNav.astro';
import Base from '../../../layouts/Base.astro';
import { docTypes, domains } from '../../../config/taxonomy';
import { docSlugOf, getDocsFor, getProjects, type Doc, type Project } from '../../../lib/content';
import { url } from '../../../lib/url';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  const paths = [];
  for (const project of projects) {
    const docs = await getDocsFor(project.id);
    for (const doc of docs) {
      paths.push({
        params: { domain: project.data.domain, project: project.id, doc: docSlugOf(doc) },
        props: { project, doc, docs },
      });
    }
  }
  return paths;
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  doc: Doc;
  docs: Doc[];
}
const { project, doc, docs } = Astro.props;
const { Content } = await render(doc);
const d = doc.data;
const base = `/${project.data.domain}/${project.id}`;
const index = docs.findIndex((x) => x.id === doc.id);
const prev = docs[index - 1];
const next = docs[index + 1];
---

<Base title={`${d.title} | ${project.data.title}`} description={d.summary ?? project.data.summary}>
  <Breadcrumb
    items={[
      { label: domains[project.data.domain].label, href: `/${project.data.domain}` },
      { label: project.data.title, href: base },
      { label: d.title },
    ]}
  />

  <header class="head">
    <p class="label">
      Sheet {index + 1} of {docs.length + 1}{docTypes[d.type] !== d.title && ` / ${docTypes[d.type]}`}
    </p>
    <h1>{d.title}</h1>
    {d.summary && <p class="summary">{d.summary}</p>}
  </header>

  <div class="layout">
    <SheetNav project={project} docs={docs} current={docSlugOf(doc)} />

    <article>
      {
        d.palette && (
          <ul class="swatches">
            {d.palette.map((s) => (
              <li>
                <span class="chip" style={`background: ${s.hex}`} />
                <span class="sname">{s.name}</span>
                <span class="label">{s.hex.toUpperCase()}</span>
                {s.role && <span class="role">{s.role}</span>}
              </li>
            ))}
          </ul>
        )
      }

      {
        d.images && (
          <div class="gallery">
            {d.images.map((img) => (
              <Figure image={img} sizes="(max-width: 800px) 100vw, 560px" />
            ))}
          </div>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <nav class="pager" aria-label="Previous and next sheet">
        {prev ? <a href={url(`${base}/${docSlugOf(prev)}`)}><span class="label">Previous</span>{prev.data.title}</a> : <span />}
        {
          next ? (
            <a class="nx" href={url(`${base}/${docSlugOf(next)}`)}><span class="label">Next</span>{next.data.title}</a>
          ) : (
            <a class="nx" href={url(`${base}/changelog`)}><span class="label">Next</span>Changelog</a>
          )
        }
      </nav>
    </article>
  </div>
</Base>

<style>
  .head {
    margin: var(--space-3) 0 var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .head .label { color: var(--brand-hi); }
  .head h1 { margin-top: var(--space-2); }
  .summary { color: var(--text-muted); margin-top: var(--space-2); max-width: var(--prose-max); }

  .layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  article { display: flex; flex-direction: column; gap: var(--space-5); min-width: 0; }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-4);
  }

  .swatches {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-3);
  }
  .swatches li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-2);
  }
  .chip { height: 64px; border-radius: var(--radius); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1); }
  .sname { color: var(--text-bright); font-size: var(--text-sm); font-weight: 600; }
  .role { color: var(--text-muted); font-size: var(--text-sm); }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
    color: var(--text-bright);
  }
  .pager .nx { text-align: right; margin-left: auto; }

  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
  }
</style>
