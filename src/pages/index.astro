---
import Base from '../layouts/Base.astro';
import { site } from '../config/site';
---

<Base>
  <p class="label">Workshop Floor</p>
  <h1>{site.name}</h1>
  <p class="lede">{site.description}</p>
</Base>

<style>
  h1 { margin: var(--space-2) 0 var(--space-3); }
  .lede { color: var(--text-muted); max-width: var(--prose-max); }
</style>
