---
import Tag from '../../components/Tag.astro';
import Base from '../../layouts/Base.astro';
import { getNotes, type Note } from '../../lib/content';
import { url } from '../../lib/url';

const notes = await getNotes();

// Group notes by month, newest first, e.g. "September 2026".
const months = new Map<string, Note[]>();
for (const note of notes) {
  const key = note.data.date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
  months.set(key, [...(months.get(key) ?? []), note]);
}

// A short plain-text preview from the start of the note.
const excerpt = (body = '') =>
  body
    .replace(/[#*_`>\[\]()-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()
    .slice(0, 160);

const stamp = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short' });
---

<Base title="Notebook" description="Rough notes and ideas.">
  <header class="head">
    <h1>Notebook</h1>
    <p class="sub">Rough notes and ideas. Unfinished by design.</p>
  </header>

  <div class="book">
    {notes.length === 0 && <p class="empty">No notes yet.</p>}
    {
      [...months].map(([month, entries]) => (
        <section>
          <h2 class="label month">{month}</h2>
          <ol class="entries">
            {entries.map((note) => (
              <li>
                <a class="entry" href={url(`/notebook/${note.id}`)}>
                  <span class="stamp">{stamp(note.data.date)}</span>
                  <span class="text">
                    <span class="title">{note.data.title}</span>
                    <span class="preview">{excerpt(note.body)}</span>
                    {(note.data.tags.length > 0 || note.data.draft) && (
                      <span class="tags">
                        {note.data.tags.map((t) => <Tag label={t} />)}
                        {note.data.draft && <Tag label="Draft" />}
                      </span>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .head {
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }
  .sub { color: var(--text-muted); margin-top: var(--space-2); }
  .empty { color: var(--text-muted); }

  /* A notebook page: a ruled margin down the left. */
  .book {
    max-width: 820px;
    border-left: 1px dashed var(--line-strong);
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-6);
  }
  .month { color: var(--brand-hi); letter-spacing: var(--tracking-label); margin-bottom: var(--space-3); }

  .entries { list-style: none; display: grid; }
  .entry {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-3) var(--space-2);
    border-bottom: 1px dashed var(--line);
    text-decoration: none;
    color: inherit;
  }
  .entry:hover { background: var(--bg-raised); }
  .stamp {
    font: 500 var(--text-xs) var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-hi);
    padding-top: 3px;
  }
  .text { display: grid; gap: var(--space-1); }
  .title { color: var(--text-bright); font-weight: 600; }
  .entry:hover .title { color: var(--brand-hi); }
  .preview { color: var(--text-muted); font-size: var(--text-sm); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: var(--space-1); }

  @media (max-width: 520px) {
    .book { padding-left: var(--space-3); }
    .entry { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
