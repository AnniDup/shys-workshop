---
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Tag from '../../components/Tag.astro';
import Base from '../../layouts/Base.astro';
import { formatDate, getNotes, type Note } from '../../lib/content';
import { url } from '../../lib/url';

export const getStaticPaths = (async () => {
  const notes = await getNotes();
  return notes.map((note, i) => ({
    params: { note: note.id },
    // Notes are newest first, so "newer" is the one before in the list.
    props: { note, newer: notes[i - 1], older: notes[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  note: Note;
  newer?: Note;
  older?: Note;
}
const { note, newer, older } = Astro.props;
const { Content } = await render(note);
const d = note.data;
const linked = d.project ? await getEntry(d.project) : undefined;
// Only link to the project if its page exists (drafts are left out of the live build).
const project = linked && (import.meta.env.DEV || !linked.data.draft) ? linked : undefined;
---

<Base title={`${d.title} | Notebook`}>
  <Breadcrumb items={[{ label: 'Notebook', href: '/notebook' }, { label: d.title }]} />

  <article class="page">
    <header class="head">
      <p class="stamp">
        Noted {formatDate(d.date)}
        {d.updated && <span> / updated {formatDate(d.updated)}</span>}
      </p>
      <h1>{d.title}</h1>
      {
        (d.tags.length > 0 || d.draft) && (
          <div class="tags">
            {d.tags.map((t) => <Tag label={t} />)}
            {d.draft && <Tag label="Draft" />}
          </div>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      project && (
        <p class="project">
          <span class="label">Related project</span>
          <a href={url(`/${project.data.domain}/${project.id}`)}>{project.data.title}</a>
        </p>
      )
    }

    <nav class="pager" aria-label="Newer and older notes">
      {newer ? <a href={url(`/notebook/${newer.id}`)}><span class="label">Newer</span>{newer.data.title}</a> : <span />}
      {older && <a class="old" href={url(`/notebook/${older.id}`)}><span class="label">Older</span>{older.data.title}</a>}
    </nav>
  </article>
</Base>

<style>
  .page {
    max-width: 760px;
    margin-top: var(--space-4);
    border-left: 1px dashed var(--line-strong);
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-5);
  }
  .stamp {
    font: 500 var(--text-xs) var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-hi);
  }
  .head h1 { margin-top: var(--space-2); }
  .tags { display: flex; flex-wrap: wrap; gap: var(--space-1); margin-top: var(--space-3); }

  .project {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-left: 2px solid var(--brand);
    background: color-mix(in srgb, var(--bg-surface) 94%, transparent);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--line);
  }
  .pager a { display: flex; flex-direction: column; gap: var(--space-1); text-decoration: none; color: var(--text-bright); }
  .pager .old { text-align: right; margin-left: auto; }

  @media (max-width: 520px) {
    .page { padding-left: var(--space-3); }
  }
</style>
