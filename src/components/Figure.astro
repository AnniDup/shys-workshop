---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: { src: ImageMetadata; alt: string; caption?: string; detail?: string };
  sizes?: string;
}
const { image, sizes = '(max-width: 800px) 100vw, 800px' } = Astro.props;
---

<figure>
  <Image src={image.src} alt={image.alt} widths={[480, 960, 1600]} sizes={sizes} />
  {
    (image.caption || image.detail) && (
      <figcaption>
        {image.caption && <span class="cap">{image.caption}</span>}
        {image.detail && <span class="detail">{image.detail}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  figure {
    background: var(--bg-surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  figure :global(img) { width: 100%; height: auto; }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border-top: 1px solid var(--line);
  }
  .cap { color: var(--text-bright); font-weight: 600; font-size: var(--text-sm); }
  .detail { color: var(--text-muted); font-size: var(--text-sm); }
</style>
