---
import { statuses, type Status } from '../config/taxonomy';

interface Props {
  status: Status;
}
const { status } = Astro.props;
const s = statuses[status];
---

<span class="flag" style={`--s: ${s.colour}`}>{s.label}</span>

<style>
  .flag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font: 500 0.5625rem var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 2px 7px;
    border-radius: var(--radius);
    color: var(--s);
    border: 1px solid color-mix(in srgb, var(--s) 70%, transparent);
    background: color-mix(in srgb, var(--bg-void) 90%, transparent);
    white-space: nowrap;
  }
  .flag::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--s);
  }
</style>
