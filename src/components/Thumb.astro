---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// An image at a fixed ratio, or drafting-grid artwork when no image is set.
interface Props {
  image?: { src: ImageMetadata; alt: string };
  fallbackText: string;
  colour: string;
  ratio?: string;
  widths?: number[];
  sizes?: string;
}
const {
  image,
  fallbackText,
  colour,
  ratio = '16 / 9',
  widths = [400, 800],
  sizes = '(max-width: 640px) 100vw, 400px',
} = Astro.props;
---

<div class="thumb" style={`--k: ${colour}; --ratio: ${ratio}`}>
  {
    image ? (
      <Image src={image.src} alt={image.alt} widths={widths} sizes={sizes} />
    ) : (
      <span class="glyph" aria-hidden="true">{fallbackText}</span>
    )
  }
  <slot />
</div>

<style>
  .thumb {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background:
      radial-gradient(circle at 70% 40%, color-mix(in srgb, var(--k) 28%, transparent), transparent 60%),
      linear-gradient(var(--grid-major) 1px, transparent 1px) 0 0 / 16px 16px,
      linear-gradient(90deg, var(--grid-major) 1px, transparent 1px) 0 0 / 16px 16px,
      var(--bg-deep);
  }
  .thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .glyph {
    position: absolute;
    right: 14px;
    bottom: 4px;
    font: 400 3.25rem/1 var(--font-display);
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--k) 75%, transparent);
  }
</style>
